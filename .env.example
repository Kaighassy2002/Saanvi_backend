# MongoDB
CONNECTION_STRING=mongodb+srv://user:pass@cluster.mongodb.net/jewellery

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# Server
PORT=5000
# Comma-separated list of allowed frontend origins in production
# Example: CORS_ALLOWED_ORIGINS=https://shop.example.com,https://admin.example.com
# Leave empty for local default (http://localhost:5173)
# CORS_ALLOWED_ORIGINS=

# Seed admin (change in production)
ADMIN_EMAIL=admin@jewellery.com
ADMIN_PASSWORD=admin123

# Sample product catalog on startup (set false to keep DB empty after npm run clear:products)
# SEED_PRODUCTS=false

# Gmail OTP (optional)
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# MAIL_FROM=

# Shipping defaults (used when DB has no admin value yet; edit in Admin → Shipping)
# FREE_SHIPPING_THRESHOLD=2999
# SHIPPING_FEE=99

# Razorpay (required for UPI/card payment checkout)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Cloudinary — product image uploads (admin)
# https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional — match your Media Library folder path (case-sensitive). "Home" is root; do not include "Home" in the path.
# CLOUDINARY_FOLDER=Jewellery/Products
